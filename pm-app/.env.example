# Database Configuration
# ----------------------
# Option 1: Direct DATABASE_URL (traditional)
# DATABASE_URL=postgresql://user:password@localhost:5432/pm_database

# Option 2: Separate params for Cloud SQL (recommended for Cloud Run)
DB_USER=pm_user
DB_PASSWORD=your_password_here
DB_NAME=pm_database

# For local dev with Cloud SQL Proxy (TCP connection):
DB_HOST=127.0.0.1
DB_PORT=5432

# For Cloud Run deployment (Unix socket connection):
# DB_CONNECTION_NAME=your-project:us-central1:your-instance
# DB_SOCKET_PATH=/cloudsql

# Pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Model Storage Configuration
MODEL_STORAGE_BACKEND=local
MODEL_STORAGE_PATH=../artifacts
# For GCS: MODEL_STORAGE_BACKEND=gcs
# For GCS: GCS_MODEL_BUCKET=pm-models-prod

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro-exp
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=60

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
LOG_LEVEL=INFO
LOG_FORMAT=text
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
